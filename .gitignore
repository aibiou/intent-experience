# dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# compiled core bundle for the in-process evidence harness
dist/

# local env / secrets — never commit
.env
.env.*
!.env.example

# logs
*.log

# TypeScript incremental build info (generated by next build / tsc)
tsconfig.tsbuildinfo

# browser automation state / demo screenshots (not product or evidence artifacts)
.playwright-mcp/
product-home.png

# local provider config store (S5B——密文持久化；绝不提交)
data/

# evidence run traces (NTFS ADS on Windows——`G3-GOLDEN-0001:G01-B.jsonl` 为
# 主文件的备用数据流，git 无法跨平台可靠管理；trace 哈希已固化于 cases/*.json
# 的 evidence.traceSha256，故仅保留磁盘供本机审计，不入库)
artifacts/evidence/runs/**/traces/
